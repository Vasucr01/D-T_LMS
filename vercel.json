{
  "version": 2,
  "functions": {
    "api/**": {
      "includeFiles": [
        "assets/**",
        "node_modules/pdfkit/js/standard-fonts/**",
        "node_modules/pdfkit/js/data/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
